diff --git a/src/include/features.h b/src/include/features.h
index f17bd15..5b22fdb 100644
--- a/src/include/features.h
+++ b/src/include/features.h
@@ -5,7 +5,17 @@
 
 #define weak __attribute__((__weak__))
 #define hidden __attribute__((__visibility__("hidden")))
+#ifdef __TINYC__
+/* TCC's __attribute__((alias(...))) only renames references within the
+ * same translation unit; it does not emit a second ELF symbol, so
+ * cross-TU weak-alias lookups (the entire point of this macro) fail
+ * silently. TCC's assembler correctly implements .weak/.set, so drop
+ * to that directly. See spike notes: docs/tcc-spike-findings.md */
+#define weak_alias(old, new) \
+	__asm__(".weak " #new "\n.set " #new ", " #old "\n")
+#else
 #define weak_alias(old, new) \
 	extern __typeof(old) new __attribute__((__weak__, __alias__(#old)))
+#endif
 
 #endif
