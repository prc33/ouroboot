diff --git a/tools/gen_asm_words.sh b/tools/gen_asm_words.sh
new file mode 100755
index 0000000..4abca66
--- /dev/null
+++ b/tools/gen_asm_words.sh
@@ -0,0 +1,58 @@
+#!/bin/sh
+# Regenerates the .long-encoded replacements for musl's riscv64 .s files.
+#
+# TCC has no RISC-V assembler, but tccasm.c's DIRECTIVE handling
+# (.globl/.weak/.set/.long/.type) is generic and works fine -- only
+# instruction mnemonics route to the (absent) arch backend. So these
+# files are emitted as raw .long encodings with the original mnemonic
+# preserved in a comment on every line.
+#
+# NOTE: uses .long (4 bytes on every TCC target), not .word. TCC's
+# generic .word directive is 2 bytes -- x86/GAS legacy, inherited from
+# the i386-first codebase -- which silently truncated every RISC-V
+# instruction word to its low 16 bits when this script first used it.
+# Confirmed the hard way: __set_thread_area's first instruction
+# encoded as 0x00050213 in source came out as the entirely different
+# instruction 0x05130213 (the low 16 bits of THIS word concatenated
+# with the low 16 bits of the NEXT .word directive). See
+# docs/riscv-port-findings.md.
+#
+# Also pulls the full symbol table via nm, not just objdump -d's
+# per-address annotation: when multiple names alias one address (e.g.
+# setjmp/_setjmp/__setjmp all at the same address), objdump -d only
+# labels it with one of them, silently dropping the others as
+# .globl'd symbols in naive output.
+#
+# Uses the host binutils assembler at GENERATION time only; the
+# generated output is checked in and needs no toolchain to build. Same
+# pattern as the kernel's ISR-stub generator.
+#
+# Usage: tools/gen_asm_words.sh <in.s> <symbolname>
+set -e
+IN="$1"
+riscv64-linux-gnu-as -march=rv64imafd -o /tmp/_g.o "$IN"
+echo "/* GENERATED from $IN by tools/gen_asm_words.sh -- do not hand-edit. */"
+riscv64-linux-gnu-nm /tmp/_g.o | awk '$2=="T"||$2=="t"{print $1, $3}' > /tmp/_g.syms
+riscv64-linux-gnu-objdump -d /tmp/_g.o | awk -v symsfile=/tmp/_g.syms '
+BEGIN {
+  while ((getline line < symsfile) > 0) {
+    split(line, f, " ")
+    addr = f[1]; name = f[2]
+    syms[addr] = syms[addr] " " name
+  }
+}
+/^[0-9a-f]+ </ {
+  addr = $1
+  n = split(syms[addr], names, " ")
+  for (i = 1; i <= n; i++) {
+    print ".globl " names[i]
+    print names[i] ":"
+  }
+  next
+}
+/^ +[0-9a-f]+:/ {
+  ins=$2; $1=""; $2="";
+  gsub(/^[ \t]+/,"");
+  printf "\t.long 0x%s\t/* %s */\n", ins, $0
+}'
+
