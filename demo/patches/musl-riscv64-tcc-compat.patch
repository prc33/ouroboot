diff --git a/arch/riscv64/atomic_arch.h b/arch/riscv64/atomic_arch.h
index 0c38258..4bea59f 100644
--- a/arch/riscv64/atomic_arch.h
+++ b/arch/riscv64/atomic_arch.h
@@ -1,3 +1,45 @@
+/* Built with TCC, which has no RISC-V assembler. These are the only
+ * three primitives musl needs from this header, and all three are
+ * implemented below without inline asm.
+ *
+ * IMPORTANT -- these are NOT atomic. They are correct only on a
+ * uniprocessor with no preemption inside the sequence, which matches
+ * this project's scope (single-core throughout; the same uniprocessor
+ * assumption we already make for the kernel). A real SMP build MUST
+ * restore the lr/sc versions preserved below, or these will silently
+ * corrupt shared state under contention.
+ *
+ * The A (atomic) extension is also exactly the kind of thing we would
+ * otherwise have to implement in the FPGA core, so avoiding it here is
+ * consistent with keeping the required hardware subset minimal.
+ */
+#ifdef __TINYC__
+
+#define a_barrier a_barrier
+static inline void a_barrier()
+{
+	/* compiler barrier only; no reordering hardware to fence on a
+	 * single in-order core */
+}
+
+#define a_cas a_cas
+static inline int a_cas(volatile int *p, int t, int s)
+{
+	int old = *p;
+	if (old == t) *p = s;
+	return old;
+}
+
+#define a_cas_p a_cas_p
+static inline void *a_cas_p(volatile void *p, void *t, void *s)
+{
+	void *old = *(void *volatile *)p;
+	if (old == t) *(void *volatile *)p = s;
+	return old;
+}
+
+#else
+
 #define a_barrier a_barrier
 static inline void a_barrier()
 {
@@ -36,3 +78,5 @@ static inline void *a_cas_p(volatile void *p, void *t, void *s)
 		: "memory");
 	return old;
 }
+
+#endif
diff --git a/arch/riscv64/crt_arch.h b/arch/riscv64/crt_arch.h
index 6b93fcf..bd9837a 100644
--- a/arch/riscv64/crt_arch.h
+++ b/arch/riscv64/crt_arch.h
@@ -1,3 +1,27 @@
+/* Built with TCC, which has no RISC-V assembler. Upstream's _start is
+ * an __asm__ block; here it is plain C.
+ *
+ * The trick: TCC's function prologue is
+ *     addi sp,sp,-N ; sd ra,.. ; sd s0,.. ; addi s0,sp,N
+ * so inside any function s0 holds the stack pointer as it was on
+ * entry -- which is exactly where the kernel left argc/argv/envp.
+ * __builtin_riscv_read_fp() reads s0, giving _start_c the pointer it
+ * expects without a line of assembly.
+ *
+ * Dropped vs upstream, deliberately:
+ *  - gp (__global_pointer$) setup: TCC does not emit gp-relative
+ *    addressing, so gp is never read. Left at whatever the kernel set.
+ *  - _DYNAMIC / PIE support: we build static non-PIE only, so the
+ *    dynamic-section pointer is always NULL.
+ *  - the andi sp,sp,-16 realignment: the kernel is responsible for
+ *    handing us a 16-byte-aligned stack (ours does).
+ */
+#ifdef __TINYC__
+
+#define _START_C_FROM_C 1
+
+#else
+
 __asm__(
 ".section .sdata,\"aw\"\n"
 ".text\n"
@@ -17,3 +41,5 @@ START ":\n"
 "andi sp, sp, -16\n\t"
 "tail " START "_c"
 );
+
+#endif
diff --git a/arch/riscv64/pthread_arch.h b/arch/riscv64/pthread_arch.h
index a20d7fb..8b86602 100644
--- a/arch/riscv64/pthread_arch.h
+++ b/arch/riscv64/pthread_arch.h
@@ -1,7 +1,11 @@
 static inline uintptr_t __get_tp()
 {
 	uintptr_t tp;
+#ifdef __TINYC__
+	tp = (uintptr_t)__builtin_riscv_read_tp();
+#else
 	__asm__ __volatile__("mv %0, tp" : "=r"(tp));
+#endif
 	return tp;
 }
 
diff --git a/arch/riscv64/syscall_arch.h b/arch/riscv64/syscall_arch.h
index 7fd042c..4ed9ba6 100644
--- a/arch/riscv64/syscall_arch.h
+++ b/arch/riscv64/syscall_arch.h
@@ -1,6 +1,40 @@
 #define __SYSCALL_LL_E(x) (x)
 #define __SYSCALL_LL_O(x) (x)
 
+/* Built with TCC, which has no RISC-V assembler (upstream ships only a
+ * stub that errors out). Rather than write one, we use a TCC intrinsic
+ * that reuses the ordinary C call path -- the RISC-V C ABI already puts
+ * the first 8 integer args in a0-a7, which IS the Linux syscall
+ * convention (args in a0-a5, number in a7), so only the final
+ * instruction differs. The intrinsic always takes 8 arguments; unused
+ * argument slots are padded with 0 here, and the syscall number always
+ * goes last so it lands in a7.
+ * See docs/riscv-port-findings.md. */
+#ifdef __TINYC__
+
+static inline long __syscall0(long n)
+{ return __builtin_riscv_syscall(0,0,0,0,0,0,0,n); }
+
+static inline long __syscall1(long n, long a)
+{ return __builtin_riscv_syscall(a,0,0,0,0,0,0,n); }
+
+static inline long __syscall2(long n, long a, long b)
+{ return __builtin_riscv_syscall(a,b,0,0,0,0,0,n); }
+
+static inline long __syscall3(long n, long a, long b, long c)
+{ return __builtin_riscv_syscall(a,b,c,0,0,0,0,n); }
+
+static inline long __syscall4(long n, long a, long b, long c, long d)
+{ return __builtin_riscv_syscall(a,b,c,d,0,0,0,n); }
+
+static inline long __syscall5(long n, long a, long b, long c, long d, long e)
+{ return __builtin_riscv_syscall(a,b,c,d,e,0,0,n); }
+
+static inline long __syscall6(long n, long a, long b, long c, long d, long e, long f)
+{ return __builtin_riscv_syscall(a,b,c,d,e,f,0,n); }
+
+#else
+
 #define __asm_syscall(...) \
 	__asm__ __volatile__ ("ecall\n\t" \
 	: "=r"(a0) : __VA_ARGS__ : "memory"); \
@@ -70,9 +104,10 @@ static inline long __syscall6(long n, long a, long b, long c, long d, long e, lo
 	__asm_syscall("r"(a7), "0"(a0), "r"(a1), "r"(a2), "r"(a3), "r"(a4), "r"(a5))
 }
 
+#endif
+
 #define VDSO_USEFUL
-/* We don't have a clock_gettime function.
 #define VDSO_CGT_SYM "__vdso_clock_gettime"
-#define VDSO_CGT_VER "LINUX_2.6" */
+#define VDSO_CGT_VER "LINUX_4.15"
 
 #define IPC_64 0
