@@ -20,5 +20,13 @@ void __unmapself(void *base, size_t size)
 	stack -= (uintptr_t)stack % 16;
 	unmap_base = base;
 	unmap_size = size;
+#ifdef __TINYC__
+	/* CRTJMP is inline asm (jump to a new stack after unmapping the
