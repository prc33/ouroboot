diff --git a/src/include/features.h b/src/include/features.h
index f17bd15..8c9b075 100644
--- a/src/include/features.h
+++ b/src/include/features.h
@@ -5,7 +5,15 @@
 
 #define weak __attribute__((__weak__))
 #define hidden __attribute__((__visibility__("hidden")))
+#ifdef __TINYC__
+/* TCC's __attribute__((alias(...))) is an intra-TU rename, not a real
+ * cross-TU ELF symbol. Its assembler DIRECTIVES work fine though (no
+ * arch assembler needed for those), so route through .weak/.set. */
+#define weak_alias(old, new) \
+	__asm__(".weak " #new "\n.set " #new ", " #old "\n")
+#else
 #define weak_alias(old, new) \
 	extern __typeof(old) new __attribute__((__weak__, __alias__(#old)))
+#endif
 
 #endif
diff --git a/src/internal/stdio_impl.h b/src/internal/stdio_impl.h
index 0b2438d..9310f12 100644
--- a/src/internal/stdio_impl.h
+++ b/src/internal/stdio_impl.h
@@ -64,7 +64,16 @@ hidden int __toread(FILE *);
 hidden int __towrite(FILE *);
 
 hidden void __stdio_exit(void);
+#ifdef __TINYC__
+/* weak_alias(__stdio_exit, __stdio_exit_needed) does not produce a
+ * symbol under TCC when the target has hidden visibility, so alias it
+ * at source level instead. Effect is identical for a static link:
+ * referencing __stdio_exit_needed pulls in stdio's atexit flush, which
+ * is what we want since we do use stdio. */
+#define __stdio_exit_needed __stdio_exit
+#else
 hidden void __stdio_exit_needed(void);
+#endif
 
 #if defined(__PIC__) && (100*__GNUC__+__GNUC_MINOR__ >= 303)
 __attribute__((visibility("protected")))
