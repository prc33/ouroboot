+cpp_flags      = -MD -MF $(depfile) $(NOSTDINC_FLAGS) $(__cpp_flags)
 
 # Seems to be a wrong thing to do. LDFLAGS contains gcc's flags,
 # yet ld_flags is fed to ld.
diff --git a/scripts/trylink b/scripts/trylink
index 2255dee..758cda5 100755
--- a/scripts/trylink
+++ b/scripts/trylink
@@ -78,6 +78,30 @@ CFLAGS="$3"
 LDFLAGS="$4"
 O_FILES="$5"
 A_FILES="$6"
+# crt1.o/crti.o must come first (they contain _start), libc.a/
+# libtcc1.a/crtn.o must come after everything that references them.
+# $MUSL_LIBDIR/$TCC_LIBDIR come from the environment (set by
+# build-busybox-<arch>.sh) rather than being hardcoded here, so this
+# patch applies the same way regardless of where musl/tcc were built.
+# Every "try $CC ... $O_FILES $A_FILES ..." call site in this script
+# picks this up automatically.
+O_FILES="${MUSL_LIBDIR:?MUSL_LIBDIR not set}/crt1.o $MUSL_LIBDIR/crti.o $O_FILES"
+A_FILES="$A_FILES $MUSL_LIBDIR/libc.a ${TCC_LIBDIR:?TCC_LIBDIR not set}/libtcc1.a $MUSL_LIBDIR/crtn.o"
+# TCC's linker is single-pass with no archive-group rescan (confirmed:
+# no -Wl,--start-group support at all). Relisting busybox's own
+# archives a second time is a poor-man's version of what --start-group
+# actually does (repeatedly rescan a group of archives until no more
+# symbols resolve) -- one extra pass is enough here since busybox's
+# internal dependency graph isn't deeply circular, just "many
+# directories need libbb, which is listed alphabetically among them
+# rather than first".
+A_FILES="$A_FILES $6"
+# ...and libc needs a second pass too, for the same reason: symbols
+# pulled in only during the busybox-archive re-scan above (because
+# THEY were only reachable via inter-busybox deps) can still need
+# libc functions, but by then libc.a is already behind us in the
+# single left-to-right scan and won't be revisited otherwise.
+A_FILES="$A_FILES $MUSL_LIBDIR/libc.a"
 # We try to drop libraries from LDLIBS if build works without them,
 # but ones from CONFIG_EXTRA_LDLIBS are always linked in.
 # (For example, musl has stub utmp implementation, and if you link with
@@ -93,10 +117,23 @@ if ! check_cc "-Wl,--sort-section,alignment"; then
     SORT_SECTION=""
 fi
 
-START_GROUP="-Wl,--start-group"
-END_GROUP="-Wl,--end-group"
+START_GROUP=""
+END_GROUP=""
+# TCC's linker has no archive-group symbol resolution (confirmed: fails
+# hard on -Wl,--start-group with "unsupported linker option"). Every
+# .c file compiles cleanly under TCC+musl -- this is purely a linker
+# capability gap. busybox's own build already links per-directory
+# built-in.o objects (unconditionally included, unlike lazy .a member
+# pulling) alongside the .a archives, so dropping the group wrapper
+# and relying on link-order is the direct fix rather than working
+# around TCC's linker internals.
 INFO_OPTS() {
-	echo "-Wl,--warn-common -Wl,-Map,$EXE.map -Wl,--verbose"
+	# --warn-common/-Map/--verbose are pure diagnostics (map file,
+	# extra stdout info) with no effect on the produced binary --
+	# and none of the three are supported by TCC's linker. Emptied
+	# rather than patched per-flag since this function is used
+	# identically at every "make the real final binary" call site.
+	echo ""
 }
 
 # gold may not support --sort-common (yet)
@@ -320,7 +357,6 @@ int main(int argc, char **argv)
 		$SORT_SECTION \
 		$GC_SECTIONS \
 		-L"$sharedlib_dir" -lbusybox \
-		-Wl,--warn-common \
 	|| {
 	    echo "Linking $EXE failed"
 	    cat $EXE.out
